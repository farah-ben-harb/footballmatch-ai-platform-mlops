{
  "uid": "footballmatch-platform",
  "title": "FootballMatch AI Platform",
  "tags": [
    "footballmatch",
    "mlops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(footballmatch_http_requests_total{path!~\"/health|/ready|/metrics\"}[5m])) by (path)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(footballmatch_http_requests_total{status_code=~\"5..\"}[5m])) by (path,status_code)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(footballmatch_http_request_duration_seconds_bucket{path!~\"/health|/ready|/metrics\"}[5m])) by (le,path))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Video jobs by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "jobs"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_video_jobs_total) by (status)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Frames processed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "frames"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_frames_processed_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Video job duration mean",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_video_analysis_duration_seconds_sum) / clamp_min(sum(footballmatch_video_analysis_duration_seconds_count), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Inference duration mean",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_inference_duration_seconds_sum) / clamp_min(sum(footballmatch_inference_duration_seconds_count), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Detections by label",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "detections"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_detections_total) by (label)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "RAG requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "requests"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_rag_requests_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "RAG errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "errors"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_rag_errors_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "RAG retrieval duration mean",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_rag_retrieval_seconds_sum) / clamp_min(sum(footballmatch_rag_retrieval_seconds_count), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "RAG generation duration mean",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sum(footballmatch_rag_generation_seconds_sum) / clamp_min(sum(footballmatch_rag_generation_seconds_count), 1)",
          "refId": "A"
        }
      ]
    }
  ]
}
